<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.coding.exercise</groupId>
  <artifactId>bank-app</artifactId>
  <version>1.0.0</version>
  <name>BankApp</name>
  <description>Bank App Spring Boot Project</description>

  <properties>
    <!-- Default compilation targets Java 17 (minimum supported by Spring Boot 3.x)
         so that builds succeed even when a Java 21 JDK is not available.
         A dedicated 'java21' profile restores release=21 compilation only when
         explicitly enabled via -Pjava21 (optionally with -Pwith-toolchain). -->
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Spring Boot core starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Devtools -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 database -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- JAXB (Jakarta XML Binding) for Java 21 -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
    </dependency>

    <!-- OpenAPI/Swagger UI via springdoc (replaces Springfox) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <!-- Spring Boot testing (JUnit 5) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Explicit resources configuration: disable filtering to avoid atomic moves that can fail on some container filesystems -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <!-- Use the JDK pointed to by JAVA_HOME (or the Java used to run Maven) by default.
           When the with-toolchain profile is active, the compiler will transparently use
           the configured JDK 21 toolchain; otherwise it uses the default JDK. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <!-- Default path: compile as Java 17 bytecode so builds succeed on JDK 17+. -->
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <parameters>${maven.compiler.parameters}</parameters>
        </configuration>
      </plugin>

      <!-- Pin resources plugin and ensure YAML files are not filtered -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
          <useDefaultDelimiters>true</useDefaultDelimiters>
          <nonFilteredFileExtensions>
            <nonFilteredFileExtension>yml</nonFilteredFileExtension>
            <nonFilteredFileExtension>yaml</nonFilteredFileExtension>
            <nonFilteredFileExtension>properties</nonFilteredFileExtension>
          </nonFilteredFileExtensions>
          <overwrite>true</overwrite>
        </configuration>
      </plugin>

      <!-- Global Java version check: enforce Java 17+ as the minimum runtime for building.
           Strict Java 21 enforcement is handled via the 'java21' and 'with-toolchain' profiles.
           This execution is configured as warn-only (fail=false) so default builds do not fail
           solely due to Java version checks; strict enforcement lives in the java21/with-toolchain
           profiles. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>java-version-minimum-17</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>
                    The BankApp project requires Java 17 or newer to build and run
                    (Spring Boot 3.x baseline). The JVM running Maven is lower than 17.
                    Please upgrade your JDK or point JAVA_HOME at a Java 17+ installation.

                    If you also want to compile with Java 21 bytecode, use the 'java21'
                    profile on top of a Java 21+ JDK or toolchain
                    (see README section "Java versions &amp; build profiles").
                  </message>
                </requireJavaVersion>
              </rules>
              <!-- Warn (do not fail) on unsupported Java runtimes < 17 in the default build. -->
              <fail>false</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Profile that enables the Maven Toolchains plugin when USE_TOOLCHAIN=true is set
         or when explicitly activated via -Pwith-toolchain.
         This allows compiling with a JDK 21 different from the JAVA_HOME JDK. -->
    <profile>
      <id>with-toolchain</id>
      <activation>
        <property>
          <!-- Activate automatically when -DUSE_TOOLCHAIN=true is present.
               It can also be activated explicitly via -Pwith-toolchain. -->
          <name>USE_TOOLCHAIN</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <!-- Ensure Maven uses a JDK 21 toolchain when this profile is active.
               Toolchains can be defined in ~/.m2/toolchains.xml or .mvn/toolchains.xml.
               This plugin is only executed when the 'with-toolchain' profile is active,
               so it does not run unconditionally during default builds or spring-boot:run. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-toolchains-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <goals>
                  <goal>toolchain</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <toolchains>
                <jdk>
                  <!-- Require at least Java 21; vendor-agnostic -->
                  <version>[21,)</version>
                  <vendor>any</vendor>
                </jdk>
              </toolchains>
            </configuration>
          </plugin>

          <!-- When the 'with-toolchain' profile is enabled we expect a Java 21+ toolchain
               to be configured. Enforce this so misconfigured toolchains fail fast. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>enforce-java21-with-toolchain</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21,)</version>
                      <message>
                        The 'with-toolchain' profile is active, so this build is expected to
                        run with or resolve a Java 21+ toolchain. The JVM running Maven was
                        detected as ${java.version}, which is lower than 21.

                        Please:
                          * Ensure JAVA_TOOLCHAIN_JAVA21_HOME / JAVA_21_HOME are set to a JDK 21+,
                          * Check your ~/.m2/toolchains.xml (or .mvn/toolchains.xml),
                          * Or run 'bash scripts/java21-preflight.sh' for diagnostics.
                      </message>
                    </requireJavaVersion>
                  </rules>
                  <!-- In toolchain mode, treat Java < 21 as a hard error -->
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Strict Java 21 compilation path.
         This profile:
           * sets the compiler to use --release 21, and
           * enforces that the build is running on (or resolving) a Java 21+ JDK.
         It is only enabled when explicitly requested via -Pjava21
         (optionally combined with -Pwith-toolchain when using Maven Toolchains). -->
    <profile>
      <id>java21</id>
      <properties>
        <!-- Compiler release used when the java21 profile is active. -->
        <maven.compiler.release>21</maven.compiler.release>
      </properties>
      <build>
        <plugins>
          <!-- Override the default compiler setup to use --release 21. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.11.0</version>
            <configuration>
              <release>${maven.compiler.release}</release>
              <parameters>${maven.compiler.parameters}</parameters>
            </configuration>
          </plugin>
          <!-- Enforce that Java 21+ is being used when this profile is active. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>enforce-java21-on-jdk21plus</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21,)</version>
                      <message>
                        The 'java21' profile compiles this project with Java release 21.
                        The JVM and/or toolchain resolved by Maven must therefore be
                        Java 21 or newer.
                      </message>
                    </requireJavaVersion>
                  </rules>
                  <!-- When the java21 profile is active, treat Java < 21 as a hard error. -->
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Existing profile for endpoint-only checks -->
    <profile>
      <id>endpoint-checks</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- Run only the dedicated HTTP endpoint probe class when this profile is active. -->
              <includes>
                <include>**/EndpointChecksIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
