<?xml version="1.0" encoding="UTF-8"?>
<!--
  BankApp - Spring Boot REST API backed by H2.

  Java 21 configuration notes:

  - This POM is configured for Java 21 end-to-end.
  - maven-compiler-plugin is upgraded to 3.13.0 and uses <release>21</release>.
    This version includes plexus-compiler-javac with Java 21 support.
  - maven-surefire-plugin is pinned to 3.2.5 to ensure JUnit 5 tests run correctly on Java 21.
  - maven-toolchains-plugin is configured to require a JDK 21 toolchain.
    IMPORTANT: The build agent must provide a ~/.m2/toolchains.xml that declares
    a JDK with <version>21</version> and any vendor. For example:

    <toolchains>
      <toolchain>
        <type>jdk</type>
        <provides>
          <version>21</version>
          <vendor>any</vendor>
        </provides>
        <configuration>
          <jdkHome>/path/to/jdk-21</jdkHome>
        </configuration>
      </toolchain>
    </toolchains>

  - No other plugin, profile, or property in this POM sets source/target to a
    lower Java version, so there should be no conflicts with Java 21.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Spring Boot parent constrained to 3.2.x line -->
    <version>3.2.10</version>
    <relativePath/>
  </parent>

  <groupId>com.coding.exercise</groupId>
  <artifactId>bank-app</artifactId>
  <version>1.0.0</version>
  <name>BankApp</name>
  <description>Bank App Spring Boot Project</description>

  <properties>
    <!-- Global Java version used across the project -->
    <java.version>21</java.version>

    <!-- Maven compiler properties aligned with Java 21 -->
    <!-- Kept for clarity; effective compilation is driven by maven-compiler-plugin <release>21</release> -->
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>

    <!-- Keep parameter metadata for reflection / Spring MVC -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!-- Default source encoding -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Spring Boot core starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Devtools (runtime only) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 in-memory database -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Lombok for boilerplate reduction -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- JAXB (Jakarta XML Binding) for Java 21 -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
    </dependency>

    <!-- OpenAPI/Swagger UI via springdoc -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <!-- Spring Boot testing (JUnit 5) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Plugin management with Java 21 compatible Surefire -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- Standard resources configuration -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <!-- Java compilation configured for Java 21.
           This plugin version bundles plexus-compiler-javac with Java 21 support. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Use Java 21 language level and standard library APIs -->
          <release>21</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <parameters>${maven.compiler.parameters}</parameters>
        </configuration>
      </plugin>

      <!-- Java 21 toolchain selection.
           The build agent MUST provide a ~/.m2/toolchains.xml with a JDK 21 entry.
           Vendor is set to "any" so any JDK distribution with version 21 qualifies. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>select-jdk-21</id>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <version>21</version>
              <vendor>any</vendor>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>

      <!-- Enable Spring Boot packaging and spring-boot:run -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Profile to run only the endpoint probe integration test.
         This profile does NOT override Java version or compiler settings. -->
    <profile>
      <id>endpoint-checks</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/EndpointChecksIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
