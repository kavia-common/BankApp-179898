#!/usr/bin/env sh
# PUBLIC_INTERFACE
# start - Entry point for preview environments that look for a file named 'start'.
# Purpose:
#   Ensures the app runs via Maven Wrapper (./mvnw) without requiring system Maven.
# Behavior:
#   - Binds to 0.0.0.0
#   - Uses $PORT if provided by the environment, otherwise falls back to 8989
#   - Falls back to 'sh mvnw' if execution permission on ./mvnw is not available.

set -e

PORT_VALUE="${PORT:-8989}"
ARGS="--server.port=${PORT_VALUE} --server.address=0.0.0.0"

if [ -x "./mvnw" ]; then
  exec ./mvnw spring-boot:run -Dspring-boot.run.arguments="${ARGS}"
else
  exec sh mvnw spring-boot:run -Dspring-boot.run.arguments="${ARGS}"
fi
