<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.coding.exercise</groupId>
  <artifactId>bank-app</artifactId>
  <version>1.0.0</version>
  <name>BankApp</name>
  <description>Bank App Spring Boot Project</description>

  <properties>
    <!-- Target Java 21 (LTS). Do not use maven.compiler.source/target; rely on release.
         Toolchains are optional and can be enabled via the 'with-toolchain' profile. -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Spring Boot core starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Devtools -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- H2 database -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- JAXB (Jakarta XML Binding) for Java 21 -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
    </dependency>

    <!-- OpenAPI/Swagger UI via springdoc (replaces Springfox) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>

    <!-- Spring Boot testing (JUnit 5) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Explicit resources configuration: disable filtering to avoid atomic moves that can fail on some container filesystems -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <!-- Use the JDK pointed to by JAVA_HOME (or the Java used to run Maven) by default.
           When the with-toolchain profile is active, the compiler will transparently use
           the configured JDK 21 toolchain; otherwise it uses the default JDK. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <!-- Rely on the Java release flag; do not set source/target separately. -->
          <release>${maven.compiler.release}</release>
          <parameters>${maven.compiler.parameters}</parameters>
        </configuration>
      </plugin>

      <!-- Pin resources plugin and ensure YAML files are not filtered -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
          <useDefaultDelimiters>true</useDefaultDelimiters>
          <nonFilteredFileExtensions>
            <nonFilteredFileExtension>yml</nonFilteredFileExtension>
            <nonFilteredFileExtension>yaml</nonFilteredFileExtension>
            <nonFilteredFileExtension>properties</nonFilteredFileExtension>
          </nonFilteredFileExtensions>
          <overwrite>true</overwrite>
        </configuration>
      </plugin>

      <!-- Global Java version check: warn when building with a JDK lower than 21,
           but do NOT fail the build. Strict enforcement is handled via profiles. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>java-version-warning</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>
                    The BankApp project is configured to compile with Java release 21
                    (maven.compiler.release=21), but the JVM running Maven is lower than 21.
                    The build will continue, but you may see compilation errors such as
                    "release version 21 not supported".
                    
                    Recommended:
                      * Run 'bash scripts/java21-preflight.sh' to verify your JDK setup.
                      * Either:
                          - Run Maven with a JDK 21+ (JAVA_HOME pointing at JDK 21+), or
                          - Configure and enable the 'with-toolchain' profile
                            (e.g. -Pwith-toolchain or -DUSE_TOOLCHAIN=true)
                            with a Java 21 toolchain.
                  </message>
                </requireJavaVersion>
              </rules>
              <!-- Warning-only: do not fail the build at this stage -->
              <fail>false</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Profile that enables the Maven Toolchains plugin when USE_TOOLCHAIN=true is set
         or when explicitly activated via -Pwith-toolchain.
         This allows compiling with a JDK 21 different from the JAVA_HOME JDK. -->
    <profile>
      <id>with-toolchain</id>
      <activation>
        <property>
          <!-- Activate automatically when -DUSE_TOOLCHAIN=true is present.
               It can also be activated explicitly via -Pwith-toolchain. -->
          <name>USE_TOOLCHAIN</name>
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <!-- Ensure Maven uses a JDK 21 toolchain when this profile is active.
               Toolchains can be defined in ~/.m2/toolchains.xml or .mvn/toolchains.xml.
               This plugin is only executed when the 'with-toolchain' profile is active,
               so it does not run unconditionally during default builds or spring-boot:run. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-toolchains-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <goals>
                  <goal>toolchain</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <toolchains>
                <jdk>
                  <!-- Require at least Java 21; vendor-agnostic -->
                  <version>[21,)</version>
                  <vendor>any</vendor>
                </jdk>
              </toolchains>
            </configuration>
          </plugin>

          <!-- When the 'with-toolchain' profile is enabled we expect a Java 21+ toolchain
               to be configured. Enforce this so misconfigured toolchains fail fast. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>enforce-java21-with-toolchain</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21,)</version>
                      <message>
                        The 'with-toolchain' profile is active, so this build is expected to
                        run with or resolve a Java 21+ toolchain. The JVM running Maven was
                        detected as ${java.version}, which is lower than 21.
                        
                        Please:
                          * Ensure JAVA_TOOLCHAIN_JAVA21_HOME / JAVA_21_HOME are set to a JDK 21+,
                          * Check your ~/.m2/toolchains.xml (or .mvn/toolchains.xml),
                          * Or run 'bash scripts/java21-preflight.sh' for diagnostics.
                      </message>
                    </requireJavaVersion>
                  </rules>
                  <!-- In toolchain mode, treat Java &lt; 21 as a hard error -->
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Strict Java 21 enforcement when Maven itself is running on JDK 21+.
         This profile only activates when the active JDK is 21 or newer; on older
         JDKs you will only see the global warning (no hard failure here). -->
    <profile>
      <id>enforce-java21-when-jdk21plus</id>
      <activation>
        <!-- Activate when the JVM running Maven reports Java 21 or newer -->
        <jdk>[21,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>enforce-java21-on-jdk21plus</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21,)</version>
                      <message>
                        The BankApp project is configured for Java 21. Since you are already
                        running Maven with a Java 21+ runtime (${java.version}), this rule
                        enforces that the build must continue to use Java 21 or newer.
                      </message>
                    </requireJavaVersion>
                  </rules>
                  <!-- When building directly on a JDK 21+ runtime, treat Java &lt; 21 as an error.
                       (In practice this will only fail if the runtime is misreported.) -->
                  <fail>true</fail>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Existing profile for endpoint-only checks -->
    <profile>
      <id>endpoint-checks</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!-- Run only the dedicated HTTP endpoint probe class when this profile is active. -->
              <includes>
                <include>**/EndpointChecksIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
